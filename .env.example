# Mikasa — variáveis de ambiente.
# Copie para `.env` e preencha. Nunca faça commit do `.env`.

# ── Banco de dados ────────────────────────────────────────────────────────────
# Desenvolvimento (padrão, sem instalação nenhuma):
DATABASE_URL="file:./dev.db"
# Produção com PostgreSQL — troque `provider` em prisma/schema.prisma para
# "postgresql" e use algo como:
# DATABASE_URL="postgresql://usuario:senha@host:5432/mikasa?schema=public"

# ── Autenticação ──────────────────────────────────────────────────────────────
# Segredo usado para assinar os JWT de sessão. Mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="troque-isto-por-um-segredo-longo-e-aleatorio-de-verdade"

# Duração da sessão em dias.
SESSION_DAYS="30"

# ── Aplicação ─────────────────────────────────────────────────────────────────
# URL pública da aplicação (usada em links absolutos e em cookies `Secure`).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# `development` | `test` | `production`
NODE_ENV="development"
